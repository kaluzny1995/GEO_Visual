# Supabase PostgreSQL credentials — copy to .env and fill in your values.
# Obtain them from the Supabase dashboard: Project → Connect → Connection pooling
# → Transaction pooler. Use the same project as GEO_ETL and GEO_API.
# Recommended: use a read-only role with SELECT on the dashboard views, not the
# postgres superuser (see docs/performance.md#read-only-database-role).
# See README.md ("Configuration") for details.
SUPABASE_DB_USER=postgres.<YOUR-PROJECT-REF>
SUPABASE_DB_PASSWORD=<YOUR-PASSWORD>
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
